# Copy this file to ".env" and fill in your values.

# Secret key for Flask sessions (any random string)
SECRET_KEY=change-this-to-a-random-secret

# ---- AI provider ----
# Options: local | gemini | ollama | fallback
# "local" runs a quantized model on CPU through llama.cpp, fully offline.
# "fallback" skips the LLM entirely (rule-based advisor + deterministic chat).
LLM_PROVIDER=local

# Gemini (get a free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama. Make sure `ollama serve` is running.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Local quantized model (llama.cpp). Leave MODEL_DIR unset to use <project>/models.
LOCAL_MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
LOCAL_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_MODEL_CTX=4096
LOCAL_MODEL_THREADS=0
LLM_TIMEOUT=120
CHAT_MAX_TOKENS=400
