# Copy this file to ".env" and fill in your values.

# Secret key for Flask sessions (any random string)
SECRET_KEY=change-this-to-a-random-secret

# ---- AI provider ----
# Options: gemini | ollama | fallback
# "fallback" works fully offline with no key (rule-based advisor + keyword chat).
LLM_PROVIDER=gemini

# Gemini (get a free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama (for the final local version). Make sure `ollama serve` is running.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
